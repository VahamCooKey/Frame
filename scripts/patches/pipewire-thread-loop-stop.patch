https://github.com/PipeWire/pipewire/commit/2aee8b43836597661ab516721014d23753ce7608
Author: Wim Taymans. MIT licensed, like the original source.
Applied to stable 1.6.11 (not the development branch).

Prevent enter()/iterate() racing with stop: otherwise a failed audio-server
connection can leave the client thread in poll and mpv permanently in join.

--- a/src/pipewire/thread-loop.c
+++ b/src/pipewire/thread-loop.c
@@ -242,6 +242,10 @@
 	if (loop->running) {
 		pw_log_debug("%p signal", loop);
+		/* lock here because we need to ensure the loop does not enter
+		 * while we stop it here */
+		pw_loop_lock(loop->loop);
 		pw_loop_invoke(loop->loop, do_stop, 1, NULL, 0, false, loop);
+		pw_loop_unlock(loop->loop);
 		pw_log_debug("%p join", loop);
 		pthread_join(loop->thread, NULL);
 		pw_log_debug("%p joined", loop);
