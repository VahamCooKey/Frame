// Version + exe icon. configure_file() substitutes @...@ from the
// project() VERSION — edit the version there, never here.
#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/assets/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 BEGIN
   BLOCK "StringFileInfo"
   BEGIN
     BLOCK "040904b0"
     BEGIN
       VALUE "CompanyName",      "Frame"
       VALUE "FileDescription",  "Frame"
       VALUE "FileVersion",      "@PROJECT_VERSION@"
       VALUE "OriginalFilename", "frame.exe"
       VALUE "ProductName",      "Frame"
       VALUE "ProductVersion",   "@PROJECT_VERSION@"
       VALUE "LegalCopyright",   "GPLv3"
     END
   END
   BLOCK "VarFileInfo"
   BEGIN
     VALUE "Translation", 0x409, 1200
   END
 END
